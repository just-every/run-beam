{
  "name": "@learning/beam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:email-link": "rer queue test:email-link -- sh -c \"node tests/email-link.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "rer queue verify:app -- sh -c \"node scripts/edition-authoring/cli.mjs check >/dev/null && node scripts/edition-authoring/cli.mjs verify-base --offline >/dev/null && pnpm run build && pnpm run typecheck && pnpm run test:email-link && pnpm run test:flows && pnpm run test:site\"",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:flows": "rer queue test:flows -- sh -c \"node tests/beam/flows.mjs && node tests/beam/regressions.mjs\"",
    "test:regressions": "node tests/beam/regressions.mjs",
    "test:journey": "node tests/beam/journey.mjs",
    "test:site": "node --test tests/site/site.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.56.1",
    "@runeditrun/rer": "0.2.70",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "marked": "18.0.14",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
