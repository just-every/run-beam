{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-beam",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": { "crons": ["0 8 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beam",
      "database_id": "local-beam-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "learning-beam-files"
    }
  ]
}
